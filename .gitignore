# Godot editor/import state and repository-local runtime profile
/.godot/
/.import/
/.godot-runtime/
/.runtime-captures/

# Local dependencies and native build products
/.deps/
/native/build/
/native/bin/
/build/
/out/
/dist/
**/CMakeFiles/
**/CMakeCache.txt
**/cmake_install.cmake
**/CTestTestfile.cmake
**/Makefile
*.obj
*.o
*.pdb
*.ilk
*.dll
*.exe

# Generated validation, capture, package, and profiling artifacts
/.safety-snapshots/
/artifacts/*
!/artifacts/.gdignore
/BUILD_MANIFEST.json
/diagnostics/
/profiling/
/benchmark-output/
benchmark-results*.txt
*.prof
*.trace
*.dmp

# Runtime/editor noise
*.log
*.tmp
*.bak
*.old
*~
/.vs/
/.idea/
/.vscode/settings.json
/.vscode/launch.json
/.vscode/tasks.json

# Tool and OS caches
__pycache__/
*.pyc
Thumbs.db
Desktop.ini
.DS_Store
